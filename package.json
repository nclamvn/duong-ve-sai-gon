{
  "name": "duong-ve-sai-gon",
  "version": "0.1.0-g0p",
  "private": true,
  "description": "Đường về Sài Gòn (DVSG) — browser cinematic FPS, chiến dịch 1971 → 30/4/1975; engine kế thừa HT-MB; Gate G0' kế thừa",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=webgl-ci",
    "e2e:webgpu": "HT_WEBGPU=1 playwright test --project=webgpu",
    "bench": "node scripts/bench.mjs",
    "bench:quick": "node scripts/bench.mjs --quick",
    "snapshot": "node scripts/snapshot.mjs",
    "ci": "npm run typecheck && npm run test && npm run build && npm run e2e",
    "bench:webgl": "node scripts/bench.mjs --backend webgl",
    "assets": "node scripts/fetch-assets.mjs",
    "assets:verify": "node scripts/fetch-assets.mjs --verify",
    "models:optimize": "node scripts/optimize-models.mjs",
    "assets:credits": "node scripts/credits.mjs",
    "assets:weapon": "node scripts/convert-weapon.mjs",
    "assets:model": "node scripts/convert-model.mjs",
    "registry:check": "node scripts/validate-registry.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "@recast-navigation/core": "0.43.1",
    "@recast-navigation/generators": "0.43.1",
    "@recast-navigation/three": "0.43.1",
    "ajv": "8.20.0",
    "recast-navigation": "0.43.1",
    "three": "0.185.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/three": "0.185.4",
    "fbx2gltf": "0.9.7-p1",
    "meshoptimizer": "1.2.0",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
