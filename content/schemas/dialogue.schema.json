{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://duong-ve-sai-gon.local/schemas/dialogue.schema.json",
  "title": "DialogueCueSet",
  "description": "PRD §8 DialogueCue — cueId là ID nghiệp vụ, không dùng tên file.",
  "type": "object",
  "required": [
    "cues"
  ],
  "additionalProperties": false,
  "properties": {
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cueId",
          "speaker",
          "subtitleKey",
          "priority",
          "interruptPolicy",
          "durationMs"
        ],
        "additionalProperties": false,
        "properties": {
          "cueId": {
            "type": "string",
            "pattern": "^[BDPM]\\d{2}$",
            "description": "D = G0 arena, P = Phố Vạn Hải, M = M1 Trường Sơn, B = M2 Bản Đông"
          },
          "speaker": {
            "enum": [
              "VY",
              "NAM",
              "DUY",
              "AN",
              "TRAM_BAC",
              "QUYET",
              "HAI",
              "SANG",
              "THANH",
              "GIAO_LIEN",
              "TRUNG_DOI",
              "PILOT",
              "PARA",
              "UT",
              "THU",
              "DAI"
            ]
          },
          "audio": {
            "type": [
              "string",
              "null"
            ]
          },
          "subtitleKey": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "interruptPolicy": {
            "enum": [
              "queue",
              "interrupt",
              "drop"
            ]
          },
          "durationMs": {
            "type": "integer",
            "minimum": 500
          },
          "bus": {
            "enum": [
              "dialogue",
              "radio"
            ]
          }
        }
      }
    }
  }
}
