{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://duong-ve-sai-gon.local/schemas/registry.schema.json",
  "title": "Registry lịch sử DVSG (PRD v0.2 §9, ADR-D03)",
  "type": "object",
  "required": ["registry", "version", "facts"],
  "additionalProperties": false,
  "properties": {
    "registry": { "enum": ["uniforms", "weapons", "vehicles", "aircraft", "places", "timeline", "daily-life"] },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "value", "provenance_level", "sources"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^(uni|wpn|veh|air|plc|tml|dly)\\.[a-z0-9_]+(\\.[a-z0-9_]+)+$", "description": "prefix theo registry: uni/wpn/veh/air/plc/tml/dly" },
          "value": { "type": "string", "minLength": 3, "description": "phát biểu fact — ngắn, kiểm được, một ý" },
          "year": { "type": "string", "pattern": "^\\d{4}(-\\d{4})?$" },
          "force": { "enum": ["pavn", "plaf", "tnxp", "civilian_north", "civilian_south", "arvn", "us", "other"] },
          "provenance_level": { "enum": ["P", "S", "H", "X"], "description": "P gốc/tư liệu chính; S thứ cấp có kiểm (bách khoa, bảo tàng, sách tra cứu); H suy luận; X tranh chấp" },
          "sources": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "required": ["url", "title", "accessed"],
              "additionalProperties": false,
              "properties": {
                "url": { "type": "string", "format": "uri" },
                "title": { "type": "string" },
                "publisher": { "type": "string" },
                "accessed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "quote": { "type": "string", "maxLength": 300 },
                "tier": { "enum": ["P", "S"] }
              }
            }
          },
          "disputed": { "type": "boolean", "default": false },
          "dispute_note": { "type": "string" },
          "used_by": { "type": "array", "items": { "type": "string" }, "description": "asset id, mission id (M1..M8), cinematics id" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
