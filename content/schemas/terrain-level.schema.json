{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "duong-ve-sai-gon.local/terrain-level",
  "title": "Level terrain (TIP-D04): ô DEM + splat + spawn/waypoint theo x/z (y lấy từ terrain)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "terrain",
    "camera",
    "sky",
    "layers",
    "textures",
    "models",
    "playerSpawn",
    "playerYaw",
    "botSpawns",
    "waypoints",
    "zones",
    "coverMarkers"
  ],
  "definitions": {
    "v2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "v3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "z",
        "w",
        "h"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "minimum": 16
        },
        "h": {
          "type": "number",
          "minimum": 16
        }
      }
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "terrain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "yOffset",
        "navRect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "public/assets/terrain/<id>/ (manifest type terrain)"
        },
        "yOffset": {
          "type": "number"
        },
        "navRect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "z",
            "w",
            "h"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "z": {
              "type": "number"
            },
            "w": {
              "type": "number",
              "minimum": 16
            },
            "h": {
              "type": "number",
              "minimum": 16
            }
          }
        },
        "wetness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tileMeters": {
          "type": "number",
          "minimum": 0.5
        },
        "tint": {
          "type": "integer"
        },
        "navFile": {
          "type": "string",
          "pattern": "^nav[a-z0-9-]*\\.bin$",
          "description": "DV-078: navmesh bake riêng của level trong public/assets/terrain/<id>/ (mặc định nav.bin) khi level dùng chung ô DEM nhưng khác rừng/props"
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "near",
        "far"
      ],
      "properties": {
        "near": {
          "type": "number",
          "minimum": 0.01
        },
        "far": {
          "type": "number",
          "minimum": 100
        }
      }
    },
    "sky": {
      "type": "object"
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaves",
        "mud",
        "rock",
        "grass"
      ],
      "properties": {
        "leaves": {
          "type": "string"
        },
        "mud": {
          "type": "string"
        },
        "rock": {
          "type": "string"
        },
        "grass": {
          "type": "string"
        }
      }
    },
    "textures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vegetation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "rect",
        "species"
      ],
      "description": "TIP-D05 rừng: scatter seeded theo loài (public/assets/vegetation/<id>.glb)",
      "properties": {
        "$comment": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "cellM": {
          "type": "number",
          "minimum": 16
        },
        "wind": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rect": {
          "$ref": "#/definitions/rect"
        },
        "species": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "perHa",
              "lod"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "perHa": {
                "type": "number",
                "minimum": 0
              },
              "slope": {
                "$ref": "#/definitions/v2"
              },
              "height": {
                "$ref": "#/definitions/v2"
              },
              "scale": {
                "$ref": "#/definitions/v2"
              },
              "noise": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scale"
                ],
                "properties": {
                  "scale": {
                    "type": "number",
                    "minimum": 0
                  },
                  "min": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "offset": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "DV-057: noise > max → bỏ (mọc ở chỗ trường noise THẤP, vd. bụi/cỏ ở khoảng trống tán theo noiseId của tầng tán)"
                  }
                }
              },
              "clump": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "count",
                  "radius"
                ],
                "properties": {
                  "count": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "radius": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "lod": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "minItems": 4,
                "maxItems": 4
              },
              "cast": {
                "type": "boolean"
              },
              "collider": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "radius",
                  "height"
                ],
                "properties": {
                  "radius": {
                    "type": "number",
                    "minimum": 0.01
                  },
                  "height": {
                    "type": "number",
                    "minimum": 0.1
                  }
                }
              },
              "rect": {
                "$ref": "#/definitions/rect"
              },
              "noiseId": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "sink": {
                "$ref": "#/definitions/v2"
              },
              "press": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "asset": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$",
                "description": "DV-057: GLB loài dùng chung (public/assets/vegetation/<asset>.glb); thiếu = id. Cho phép một loài xuất hiện ở hai tầng (vượt tán, tán chính) với luật đặt khác nhau"
              },
              "near": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "feature"
                ],
                "properties": {
                  "feature": {
                    "enum": [
                      "stream",
                      "water",
                      "crater",
                      "trail"
                    ]
                  },
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  }
                },
                "description": "DV-060: chỉ mọc khi khoảng cách tới mép khe/nước/hố trong [min,max] m"
              },
              "avoid": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "feature",
                    "within"
                  ],
                  "properties": {
                    "feature": {
                      "enum": [
                        "stream",
                        "water",
                        "crater",
                        "trail"
                      ]
                    },
                    "within": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              },
              "inWater": {
                "type": "boolean",
                "description": "DV-060: được mọc dưới mặt nước (mặc định không)"
              },
              "boost": {
                "type": "array",
                "description": "DV-063: mọc thêm sát đặc điểm (lưới phụ, bỏ qua noise), cùng batch",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "feature",
                    "max",
                    "perHa"
                  ],
                  "properties": {
                    "feature": {
                      "enum": [
                        "stream",
                        "water",
                        "crater",
                        "trail"
                      ]
                    },
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number",
                      "minimum": 0
                    },
                    "perHa": {
                      "type": "number",
                      "minimum": 0
                    },
                    "noiseFree": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "clear": {
          "type": "array",
          "description": "DV-078: dải/khoảng trống không mọc (polyline x/z; hai điểm trùng = vòng tròn): thân cây ≥ within, tầng thấp ≥ withinLow",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pts",
              "within"
            ],
            "properties": {
              "pts": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "$ref": "#/definitions/v2"
                }
              },
              "within": {
                "type": "number",
                "minimum": 0
              },
              "withinLow": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "fx": {
      "type": "array",
      "description": "FX môi trường (ambientFx: khói/lửa/tàn lửa/bụi) — vị trí x/z, y từ terrain + dy",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "position"
        ],
        "properties": {
          "$comment": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "smoke",
              "fire",
              "embers",
              "dust"
            ]
          },
          "position": {
            "$ref": "#/definitions/v2"
          },
          "dy": {
            "type": "number"
          },
          "scale": {
            "type": "number",
            "minimum": 0.1
          },
          "height": {
            "type": "number",
            "minimum": 1
          },
          "color": {
            "type": "integer"
          },
          "lit": {
            "type": "number",
            "minimum": 0,
            "maximum": 2,
            "description": "DV-078: khói sáng lên khi bốc cao (đêm ~0,1)"
          }
        }
      }
    },
    "airTraffic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "center",
        "flights"
      ],
      "description": "TIP-D-SKY: lượt bay ambient seeded (model manifest air_*)",
      "properties": {
        "$comment": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "center": {
          "$ref": "#/definitions/v2"
        },
        "wind": {
          "$ref": "#/definitions/v2"
        },
        "flights": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "model",
              "kind",
              "agl",
              "speed",
              "period"
            ],
            "properties": {
              "$comment": {
                "type": "string"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "model": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "kind": {
                "enum": [
                  "heli",
                  "jet",
                  "prop"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "agl": {
                "$ref": "#/definitions/v2"
              },
              "speed": {
                "type": "number",
                "minimum": 1
              },
              "period": {
                "$ref": "#/definitions/v2"
              },
              "first": {
                "type": "number",
                "minimum": 0
              },
              "radius": {
                "type": "number",
                "minimum": 200
              },
              "hover": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "at",
                  "seconds",
                  "agl"
                ],
                "properties": {
                  "at": {
                    "$ref": "#/definitions/v2"
                  },
                  "seconds": {
                    "type": "number",
                    "minimum": 1
                  },
                  "agl": {
                    "type": "number",
                    "minimum": 1
                  }
                }
              },
              "parachute": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "count"
                ],
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  }
                }
              },
              "scale": {
                "type": "number",
                "minimum": 0.01
              },
              "sound": {
                "enum": [
                  "rotor",
                  "jet",
                  "prop",
                  "none"
                ]
              },
              "gust": {
                "type": "number",
                "minimum": 0
              },
              "spin": {
                "type": "string"
              },
              "spinRate": {
                "type": "number"
              },
              "bank": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "playerSpawn": {
      "$ref": "#/definitions/v2"
    },
    "playerYaw": {
      "type": "number"
    },
    "botSpawns": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/v2"
      }
    },
    "waypoints": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/v2"
      }
    },
    "zones": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "center",
          "radius"
        ],
        "properties": {
          "center": {
            "$ref": "#/definitions/v2"
          },
          "radius": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "coverMarkers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "position",
          "facing"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "position": {
            "$ref": "#/definitions/v2"
          },
          "facing": {
            "$ref": "#/definitions/v3"
          }
        }
      }
    },
    "props": {
      "type": "array",
      "description": "props đặt tay trên terrain (M2 R1): model manifest (sandbag/crate/ammo/barrel/radio) hoặc procedural (wire = rào concertina); id đuôi _gap = gỡ được (bộc phá)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "position"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "kind": {
            "enum": [
              "wire",
              "sandbag",
              "crate",
              "ammo",
              "barrel",
              "radio",
              "drum",
              "jerrycan",
              "chest"
            ]
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "yaw": {
            "type": "number"
          },
          "len": {
            "type": "number",
            "minimum": 1
          },
          "scale": {
            "type": "number",
            "minimum": 0.1
          }
        }
      }
    },
    "climate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset",
        "date",
        "localTime",
        "utcOffsetH",
        "lat",
        "lon"
      ],
      "description": "DV-057: trời theo registry (content/ecology/climate.truong-son.json): mặt trời thiên văn từ ngày/giờ/toạ độ, preset sương, mây, mưa phùn. Có climate thì sky.sun và sky.fog bị tính lại",
      "properties": {
        "$comment": {
          "type": "string"
        },
        "preset": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "localTime": {
          "type": "string",
          "pattern": "^\\d{1,2}:\\d{2}$"
        },
        "utcOffsetH": {
          "type": "number"
        },
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        }
      }
    },
    "terrainFeatures": {
      "type": "object",
      "description": "DV-060: tham số khe suối/hố bom cho scripts/terrain-features.mjs"
    },
    "post": {
      "type": "object",
      "description": "DV-063: hậu kỳ điện ảnh riêng level",
      "additionalProperties": false,
      "properties": {
        "$comment": {
          "type": "string"
        },
        "volumetric": {
          "description": "DV-080: tia nắng thể tích xuyên tán qua sương (medium/high/ultra); false = tắt",
          "oneOf": [
            {
              "const": false
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "intensity": {
                  "type": "number"
                },
                "maxDist": {
                  "type": "number"
                },
                "canopyHeight": {
                  "type": "number"
                },
                "anisotropy": {
                  "type": "number"
                },
                "mist": {
                  "description": "DV-081: sương sát đất bám địa hình, trôi theo gió",
                  "oneOf": [
                    {
                      "const": false
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "density": {
                          "type": "number",
                          "minimum": 0
                        },
                        "height": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "speed": {
                          "type": "number"
                        },
                        "scale": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        "shafts": {
          "oneOf": [
            {
              "const": false
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "intensity": {
                  "type": "number"
                },
                "samples": {
                  "type": "number"
                },
                "density": {
                  "type": "number"
                },
                "decay": {
                  "type": "number"
                },
                "maxElevationDeg": {
                  "type": "number"
                }
              }
            }
          ]
        },
        "grade": {
          "oneOf": [
            {
              "const": false
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lift": {
                  "type": "number"
                },
                "contrast": {
                  "type": "number"
                },
                "saturation": {
                  "type": "number"
                },
                "greenDesat": {
                  "type": "number"
                },
                "split": {
                  "type": "number"
                },
                "exposure": {
                  "type": "number"
                },
                "shadowTint": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "highlightTint": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                }
              }
            }
          ]
        },
        "grain": {
          "type": "number"
        },
        "vignette": {
          "type": "number"
        },
        "bloom": {
          "type": "number"
        }
      }
    },
    "roads": {
      "type": "array",
      "description": "DV-078: đường xe (polyline x/z): rừng chừa dải trống, mặt đất vẽ đất xới; logic đoàn xe đọc theo id",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "pts",
          "halfWidth"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "pts": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/definitions/v2"
            }
          },
          "halfWidth": {
            "type": "number",
            "minimum": 1,
            "maximum": 8
          },
          "$comment": {
            "type": "string"
          }
        }
      }
    },
    "nextLevel": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "DV-078: level nối tiếp khi hoàn thành nhiệm vụ (Enter ở màn hoàn thành)"
    },
    "ambience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localTime",
        "month"
      ],
      "description": "DV-078: cảnh âm rừng theo giờ khi level không có climate (đêm)",
      "properties": {
        "localTime": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}$"
        },
