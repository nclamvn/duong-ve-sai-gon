{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ht-mb/asset-manifest",
  "title": "Asset manifest (ADR-005/006): mọi asset ngoài repo phải có nguồn + license; CC-BY phải có attribution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "totalBytes",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string"
    },
    "policy": {
      "type": "string"
    },
    "totalBytes": {
      "type": "integer",
      "minimum": 0
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "source",
          "url",
          "license",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+$"
          },
          "type": {
            "enum": [
              "texture",
              "hdri",
              "model",
              "character",
              "animation",
              "audio",
              "terrain"
            ]
          },
          "resolution": {
            "type": "string"
          },
          "use": {
            "type": "string"
          },
          "source": {
            "enum": [
              "polyhaven",
              "ambientcg",
              "kenney",
              "quaternius",
              "sketchfab-cc0",
              "sketchfab",
              "mixamo",
              "aws-terrain-tiles",
              "procedural"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "license": {
            "enum": [
              "CC0-1.0",
              "Mixamo",
              "CC-BY-4.0",
              "CC-BY-3.0",
              "PD-USGov"
            ]
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "bytes",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^assets/"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "sourceFiles": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "triangles": {
            "type": "object"
          },
          "historical": { "type": "boolean", "description": "asset thể hiện chi tiết lịch sử (quân phục, súng, xe, máy bay, biển hiệu…) → bắt buộc registryId (PRD DVSG §7.2)" },
          "registryId": { "type": "string", "pattern": "^(uni|wpn|veh|air|plc|tml|dly)\\.[a-z0-9_.]+$", "description": "fact trong content/registry/*.yaml mà asset là thể hiện" },
          "approved": { "type": "boolean", "description": "cố vấn lịch sử đã ký (PRD DVSG §7.6); false → chỉ build dev" },
          "size": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3,
            "description": "kích thước model sau chuẩn hoá (dài x, cao y, rộng z — m; scripts/convert-model.mjs)"
          },
          "attribution": {
            "type": "string",
            "description": "chuỗi credit bắt buộc với CC-BY (ADR-006)"
          }
        }
      }
    }
  }
}
